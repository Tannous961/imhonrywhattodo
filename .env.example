# Copy to .env. Never upload .env to a public repository.
PORT=4173
HOST=127.0.0.1
PUBLIC_URL=http://localhost:4173
DATA_DIR=./data
# Remains visibly in DEMO mode while blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_HOURLY_LIMIT=10
AI_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100
SHARE_DAYS=30
# Enable only behind a proxy that overwrites X-Forwarded-For;
# block direct access to the Node port in production.
TRUST_PROXY=false
# Stripe: leave blank until the payment flow is implemented and configured.
# Use test-mode values only in local/QA; never commit real secrets.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_MODE=test
# Firebase Admin: server-only secrets; configure in hosting, never in NEXT_PUBLIC variables.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
